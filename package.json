{
  "name": "iban-ts",
  "version": "1.0.0",
  "description": "Validate, format, and convert IBAN (International Bank Account Number) and BBAN (Basic Bank Account Number) for every country in the SWIFT IBAN Registry. Zero dependencies, TypeScript, ESM + CommonJS.",
  "license": "MIT",
  "author": "Altrim Beqiri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altrim/iban.js.git"
  },
  "homepage": "https://github.com/altrim/iban.js#readme",
  "bugs": {
    "url": "https://github.com/altrim/iban.js/issues"
  },
  "keywords": [
    "iban",
    "bban",
    "sepa",
    "bank",
    "bank-account",
    "validation",
    "validator",
    "iso-13616",
    "mod97",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run check:package && npm run size",
    "check:package": "node scripts/check-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint src test",
    "prepare": "husky",
    "prepublishOnly": "npm run check",
    "size": "size-limit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "6 KB"
    },
    {
      "path": "dist/index.cjs",
      "limit": "6 KB"
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@size-limit/preset-small-lib": "14.3.0",
    "husky": "9.1.7",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "size-limit": "14.3.0",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@lucide/vue": "^1.66.0"
  }
}
